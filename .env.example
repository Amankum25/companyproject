# Exchange Venue: DERIBIT or BYBIT
EXCHANGE_VENUE=DERIBIT

# Deribit Testnet Credentials (from https://test.deribit.com -> Account -> API)
DERIBIT_TESTNET_CLIENT_ID=your_deribit_client_id_here
DERIBIT_TESTNET_CLIENT_SECRET=your_deribit_client_secret_here

# Order quantity (Deribit minimum BTC option contract size is 0.1)
ORDER_QUANTITY=0.1

# (Optional: If using Bybit instead)
# BYBIT_TESTNET_API_KEY=your_bybit_key_here
# BYBIT_TESTNET_API_SECRET=your_bybit_secret_here
